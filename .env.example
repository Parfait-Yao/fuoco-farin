# Copy to `.env` and fill in. `.env` is git-ignored: never commit real values.
# Only variables prefixed NEXT_PUBLIC_ reach the browser. Everything else is server-only.

# ── App ──────────────────────────────────────────────────────────────────
# Public URL of the site, used in email links and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Settings > API Keys) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only (service role): admin script, customer ban, account deletion.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── Prisma / Supabase PostgreSQL (Connect > ORMs > Prisma) ───────────────
# Runtime: transaction pooler, port 6543. Admin pages run ~12 queries in parallel: keep connection_limit >= 10.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
# Migrations: session pooler, port 5432.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Cloudflare R2 (image storage) ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional public bucket URL (r2.dev or custom domain), no trailing slash.
# Leave the placeholder to serve images through the app (/api/images/...). No bucket CORS needed.
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Email / Nodemailer ───────────────────────────────────────────────────
# Without SMTP_HOST, emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Fuoco & Farina <no-reply@example.com>"

# ── Stripe (online payment, TEST MODE) ───────────────────────────────────
# Keep test keys (sk_test_...) even in production: the Stripe page works,
# test cards succeed, no real money moves. Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=sk_test_xxx
# Dashboard > Developers > Webhooks > endpoint https://your-domain/api/payments/stripe/webhook
# (events checkout.session.*). Local: `stripe listen --forward-to localhost:3000/api/payments/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Unpaid online orders are cancelled (stock released) after this delay.
PAYMENT_TIMEOUT_MINUTES=30

# ── Scheduled jobs ───────────────────────────────────────────────────────
# Long-running Node server: true schedules node-cron jobs at startup.
# Serverless (Vercel): false, and vercel.json calls /api/cron/* with CRON_SECRET.
ENABLE_CRON=false
CRON_SECRET=

# ── Admin bootstrap (optional, otherwise prompted) ───────────────────────
# ADMIN_PASSWORD=

# ── Tests only: a disposable local PostgreSQL (wiped by the tests) ───────
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/pizza_test
